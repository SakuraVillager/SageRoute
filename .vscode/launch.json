{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SageRoute (debug)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=dart_define.json"
            ]
        },
        {
            "name": "SageRoute (profile)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define-from-file=dart_define.json"
            ]
        },
        {
            "name": "SageRoute Web (Edge debug)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}",
            "deviceId": "edge",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define-from-file=dart_define.web.json",
                "--web-port=8080"
            ]
        }
    ]
}
